rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default-deny global safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-\\.]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Helper to check user's role from their profile document
    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isLecturer() {
      return isSignedIn() && (
        getUserRole() == 'Lecturer' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Lecturer')
      );
    }

    function isCourseRep() {
      return isSignedIn() && (
        getUserRole() == 'Course Rep' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Course Rep')
      );
    }

    // Validation Functions
    function isValidUser(data) {
      return data.userId is string && data.userId == request.auth.uid &&
             data.displayName is string && data.displayName.size() > 0 && data.displayName.size() <= 100 &&
             data.email is string && data.email.size() > 0 && data.email.size() <= 150 &&
             data.role in ['Lecturer', 'Course Rep', 'Student'] &&
             (!('enrolledCourseCodes' in data) || data.enrolledCourseCodes is list) &&
             (!('department' in data) || (data.department is string && data.department.size() <= 100)) &&
             (!('level' in data) || (data.level is string && data.level.size() <= 50));
    }

    function isValidCourse(data) {
      return data.code is string && data.code.size() > 0 && data.code.size() <= 30 &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 150 &&
             data.department is string && data.department.size() <= 100 &&
             data.lecturerId is string && data.lecturerId == request.auth.uid &&
             data.lecturerName is string && data.lecturerName.size() <= 100 &&
             (!('level' in data) || (data.level is string && data.level.size() <= 50)) &&
             (!('creditUnits' in data) || data.creditUnits is int) &&
             (!('courseRepId' in data) || data.courseRepId is string) &&
             (!('courseRepName' in data) || data.courseRepName is string);
    }

    function isValidLecture(data) {
      return data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
             data.courseCode is string && data.courseCode.size() > 0 && data.courseCode.size() <= 30 &&
             data.courseTitle is string && data.courseTitle.size() > 0 && data.courseTitle.size() <= 150 &&
             data.dayOfWeek is string && data.dayOfWeek.size() <= 20 &&
             data.startTime is string && data.startTime.size() <= 20 &&
             data.endTime is string && data.endTime.size() <= 20 &&
             data.venue is string && data.venue.size() <= 150 &&
             data.status in ['SCHEDULED', 'ONGOING', 'RESCHEDULED', 'VENUE_CHANGED', 'CANCELLED'] &&
             (!('originalVenue' in data) || data.originalVenue == null || (data.originalVenue is string && data.originalVenue.size() <= 150)) &&
             (!('originalTime' in data) || data.originalTime == null || (data.originalTime is string && data.originalTime.size() <= 50)) &&
             (!('statusReason' in data) || data.statusReason == null || (data.statusReason is string && data.statusReason.size() <= 500)) &&
             (!('department' in data) || (data.department is string && data.department.size() <= 100)) &&
             (!('level' in data) || (data.level is string && data.level.size() <= 50));
    }

    function isValidAnnouncement(data) {
      return data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
             data.courseCode is string && data.courseCode.size() > 0 && data.courseCode.size() <= 30 &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 150 &&
             data.content is string && data.content.size() > 0 && data.content.size() <= 2000 &&
             data.authorId is string && data.authorId == request.auth.uid &&
             data.authorName is string && data.authorName.size() <= 100 &&
             data.authorRole in ['Lecturer', 'Course Rep', 'Student', 'LECTURER', 'COURSE_REP', 'STUDENT'] &&
             data.urgency in ['URGENT', 'VENUE_CHANGE', 'TIME_SHIFT', 'GENERAL'];
    }

    // 1. Users collection: Isolated per-user profile
    match /users/{userId} {
      allow get: if isSignedIn() && request.auth.uid == userId;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() &&
                       isValidId(userId) &&
                       request.auth.uid == userId &&
                       isValidUser(incoming()) &&
                       incoming().createdAt is timestamp &&
                       incoming().createdAt <= request.time;
      allow update: if isSignedIn() &&
                       isValidId(userId) &&
                       request.auth.uid == userId &&
                       isValidUser(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().updatedAt is timestamp &&
                       incoming().updatedAt <= request.time;
      allow delete: if isSignedIn() && request.auth.uid == userId;
    }

    // 2. Courses collection:
    // Any signed-in user can read courses to search & enroll.
    // Lecturers can create and update courses.
    match /courses/{courseCode} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() &&
                       isValidId(courseCode) &&
                       isValidCourse(incoming()) &&
                       incoming().createdAt is timestamp &&
                       incoming().createdAt <= request.time;
      allow update: if isSignedIn() &&
                       isValidId(courseCode) &&
                       isValidCourse(incoming()) &&
                       incoming().code == existing().code &&
                       incoming().lecturerId == existing().lecturerId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().updatedAt is timestamp &&
                       incoming().updatedAt <= request.time;
      allow delete: if isSignedIn() && existing().lecturerId == request.auth.uid;
    }

    // 3. Lectures collection:
    // Any signed-in user can view lectures for schedule and updates.
    // Lecturers and Course Reps can create/update lecture details, times, venues, and cancellations.
    match /lectures/{lectureId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() &&
                       isValidId(lectureId) &&
                       isValidLecture(incoming()) &&
                       incoming().createdAt is timestamp &&
                       incoming().createdAt <= request.time;
      allow update: if isSignedIn() &&
                       isValidId(lectureId) &&
                       isValidLecture(incoming()) &&
                       incoming().id == existing().id &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().updatedAt is timestamp &&
                       incoming().updatedAt <= request.time;
      allow delete: if isSignedIn();
    }

    // 4. Announcements collection:
    // Signed-in users can read broadcast announcements.
    // Authorized lecturers and course reps can create announcements.
    match /announcements/{announcementId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() &&
                       isValidId(announcementId) &&
                       isValidAnnouncement(incoming()) &&
                       incoming().createdAt is timestamp &&
                       incoming().createdAt <= request.time;
      allow update: if false; // Announcements are immutable broadcasts
      allow delete: if isSignedIn() && existing().authorId == request.auth.uid;
    }
  }
}
